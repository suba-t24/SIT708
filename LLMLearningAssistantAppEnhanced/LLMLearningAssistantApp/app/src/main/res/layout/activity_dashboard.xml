<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, Student"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/btnChangeInterests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change Interests"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Profile"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have 1 task due"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generated Task 1"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvTaskDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task description"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnStartTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Task"
                android:textColor="@android:color/white"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSummarizeLesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summarise Lesson"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnCreateFlashcards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create 3 Flashcards"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnStudyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggest 7-Day Study Plan"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prompt will appear here"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:layout_marginTop="18dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvLlmResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FEE2E2"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>