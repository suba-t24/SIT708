<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generated Task 1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Question 1 -->
        <TextView
            android:id="@+id/q1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/groupQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/q1Option1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q1Option2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q1Option3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q1Option4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnHintQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Hint"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvPromptQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/progressQ1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHintQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvErrorQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FEE2E2"
            android:visibility="gone" />

        <!-- Question 2 -->
        <TextView
            android:id="@+id/q2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/groupQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/q2Option1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q2Option2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q2Option3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q2Option4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnHintQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Hint"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvPromptQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/progressQ2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHintQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvErrorQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FEE2E2"
            android:visibility="gone" />

        <!-- Question 3 -->
        <TextView
            android:id="@+id/q3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/groupQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/q3Option1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q3Option2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q3Option3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
            <RadioButton android:id="@+id/q3Option4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnHintQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Hint"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvPromptQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/progressQ3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHintQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvErrorQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FEE2E2"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmitTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:textColor="@android:color/white"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>